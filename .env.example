# SkillPath AI Environment Configuration
# Core requirement: The app runs end-to-end with ZERO API keys (deterministic rule-based fallback).
# To enable Google Gemini AI agents, provide your API key below:

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Backend Configuration
DATABASE_URL=sqlite:///./skillpath.db
SECRET_KEY=skillpath-super-secret-jwt-key-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
